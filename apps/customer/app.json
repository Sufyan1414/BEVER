{
  "expo": {
    "name": "BEVER Customer",
    "slug": "bever-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bever.customer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bever.customer"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BEVER uses your location to pin your exact delivery spot so the rider can find you."
        }
      ]
    ]
  }
}