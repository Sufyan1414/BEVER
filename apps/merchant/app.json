{
  "expo": {
    "name": "BEVER Merchant",
    "slug": "bever-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bever.merchant"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bever.merchant",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "BEVER Merchant needs your photos so you can add product pictures.",
          "cameraPermission": "BEVER Merchant needs the camera so you can photograph your products."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BEVER Merchant uses your location once to record where your shop is, so riders can find it."
        }
      ]
    ]
  }
}