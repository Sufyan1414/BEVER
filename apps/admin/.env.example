# Admin web environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# IMPORTANT: The admin app runs in a browser but must be access-controlled.
# The service-role key must ONLY be used in server-side admin operations,
# never in client-side browser code.

VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# WARNING: The service-role key below is for future server-side admin functions only.
# DO NOT expose this in any browser-facing JavaScript bundle.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
