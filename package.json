{
  "name": "bever",
  "version": "0.1.0",
  "private": true,
  "description": "BEVER — Hyperlocal Marketplace & Delivery Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "customer": "npm run start --workspace=@bever/customer",
    "merchant": "npm run start --workspace=@bever/merchant",
    "rider": "npm run start --workspace=@bever/rider",
    "admin": "npm run dev --workspace=@bever/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.0"
  }
}
